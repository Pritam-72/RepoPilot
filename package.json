{
  "name": "agentic-code-reviewer",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --parallel",
    "review": "tsx packages/agents/src/cli.ts",
    "benchmark": "tsx benchmark/runner/index.ts",
    "benchmark:multi": "tsx benchmark/runner/index.ts --multi",
    "test:benchmark": "vitest run tests/evaluation/benchmark-phase3.test.ts tests/evaluation/benchmark-phase4.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
