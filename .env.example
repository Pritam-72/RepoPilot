# -----------------------------------------------------------------------------
# RepoPilot / Agentic Code Reviewer - Environment Configuration Blueprint
# -----------------------------------------------------------------------------

# Environment & Server Settings
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database Configuration (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:password@localhost:5432/repopilot?schema=public"

# Queue & Cache Configuration (Redis 7+)
REDIS_URL="redis://localhost:6379"

# GitHub App Integration
# Obtain these values from your GitHub App settings (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID="Iv1.xxxxxxxxxxxx"
GITHUB_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GITHUB_WEBHOOK_SECRET="replace-with-your-strong-webhook-secret-token"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# AI Model Providers
# Google Gemini API key (Primary model: gemini-2.5-flash / gemini-2.5-pro)
GEMINI_API_KEY="AIzaSy..."

# Review Engine Defaults
DEFAULT_CONFIDENCE_THRESHOLD=0.75
MAX_FILES_PER_REVIEW=50
MAX_DIFF_LINES=2000
DOCKER_SANDBOX_ENABLED=true
