# =============================================================================
# Agentic Code Reviewer (Version 2.0.0) — Environment Configuration
# Aligned with plan.md Section 6.3
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # PEM contents (use \n for newlines) or path
GITHUB_WEBHOOK_SECRET=
GITHUB_BENCHMARK_TOKEN=        # read-only PAT, benchmark mining only

# --- LLM Providers ---
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=gemini    # gemini | anthropic
LLM_REVIEW_MODEL=gemini-1.5-pro # set from provider docs; never hard-code in logic
LLM_VERIFY_MODEL=gemini-1.5-flash # prefer a different model from the review model
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3

# --- Data ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/repopilot?schema=public
REDIS_URL=redis://localhost:6379

# --- Review Behaviour & Cost Guards ---
MAX_COMMENTS_PER_PR=15
MIN_CONFIDENCE=0.7
MAX_FILES_PER_REVIEW=60
MAX_TOKENS_PER_REVIEW=500000   # hard cost cap
AGENT_TIMEOUT_MS=120000

# --- Observability (Optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
